  V1: resteasy-jaxb-provider-3.0.8.Final.jar, resteasy-jaxrs-3.0.8.Final.jar, jaxrs-api-3.0.8.Final.jar
  V2: resteasy-jaxb-provider-3.0.9.Final.jar, resteasy-jaxrs-3.0.9.Final.jar, jaxrs-api-3.0.9.Final.jar
