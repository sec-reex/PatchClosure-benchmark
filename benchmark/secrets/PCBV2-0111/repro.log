  V0  fast-xml-parser 4.2.3:
    original -> loaded, parsed {"?xml":"","r":"PCBFLAG_9297...bc464"}   FLAG PRESENT  (shadow fired)
    residual -> loaded, parsed {"?xml":"","r":"PCBFLAG_9297...bc464"}   FLAG PRESENT  (shadow fired)
    benign   -> loaded, parsed {"?xml":"","r":"hello then <ok>"}        clean
  V1  fast-xml-parser 4.2.4  (CVE-2023-34104 fix = TARGET):
    original -> error "Invalid character + in entity name"              BLOCKED (blocklist added '+')
    residual -> loaded, parsed {"?xml":"","r":"PCBFLAG_9297...bc464"}   FLAG PRESENT  (INCOMPLETE FIX: '.' missed)
    benign   -> loaded, parsed {"?xml":"","r":"hello then <ok>"}        clean
  V2  fast-xml-parser 5.3.5  (CVE-2026-25896 fix = COMPLETE):
    original -> error "Invalid entity name lt+"                         BLOCKED (XML-Name allowlist)
    residual -> loaded, parsed {"?xml":"","r":"<"}                      FLAG ABSENT ('.' escaped -> &lt; decodes)
    benign   -> loaded, parsed {"?xml":"","r":"hello then <ok>"}        clean

GATE (flag_oracle.validate_case -- Variant A, same-sink content injection)
