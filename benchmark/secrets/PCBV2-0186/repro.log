V1: apache/rocketmq:5.1.1  (nameserver blocks kvConfigPath + configStorePathName [wrong name])
V2: apache/rocketmq:5.1.2  (nameserver blocks kvConfigPath + configStorePath [correct name])

--- Gate (Variant A: same-sink) ---
{
  "original_poc_reaches_flag_on_v0": true,   # kvConfigPath -> /tmp/pcb_marker.txt: KV config persisted with flag
  "original_poc_blocked_on_v1": true,         # kvConfigPath blocked: code=16 NO_PERMISSION
  "bypass_poc_reaches_flag_on_v1": true,      # configStorePath -> /tmp/pcb_marker.txt: namesrv config persisted with flag
  "passed": true
