# repro.log — dbi-cve-2026-14739 (CVE-2026-10879 -> CVE-2026-14739)
# Variant C dos-threshold gate, real Docker (perl:5.40-bookworm + CPAN DBI).

## Environment
- docker server 29.4.0 (darwin)
- images built from Dockerfile (ARG DBI_VERSION): 1.647 / 1.648 / 1.650
- containers: pcb-dbi-v0 / pcb-dbi-v1 / pcb-dbi-v2 (sleep infinity; probe via docker exec)

## Version check (2026-08-01)
$ docker exec pcb-dbi-v0 perl -MDBI -e 'print $DBI::VERSION'
1.647
$ docker exec pcb-dbi-v1 perl -MDBI -e 'print $DBI::VERSION'
1.648
$ docker exec pcb-dbi-v2 perl -MDBI -e 'print $DBI::VERSION'
1.650

## Source verification (CPAN tarballs 1.647/1.648/1.649/1.650)
- 1.647: DBI.xs preparse() allocates newSV(strlen(statement)*3)
- 1.648: ChangeLog "Fix possible buffer overflow in preparse (CVE-2026-10879)";
         DBI.xs allocates newSV(strlen(statement)*6 + 16)
- 1.649: identical DBI.xs (doc-only re-release); same overflow window
- 1.650: ChangeLog "Set a hard limit of 99999 on '?' placeholders (CVE-2026-14739)";
         DBI.xs allocates newSV(strlen(statement)*7 + 16) and rejects idx >= 99999

## Threshold calibration (probe.pl <N>, exit code)
DBI 1.647: N=1000 -> 0; N=1500 -> 134 (SIGABRT); N>=50000 -> 139 (SIGSEGV)
DBI 1.648: N=5000 -> 0; N=11000 -> 0; N=20000 -> 134; N>=100000 -> 139; N=1200000 -> 134
DBI 1.650: N=5000 -> 0 ("ok len=28893"); N=1200000 -> 0 (clean "Limit exceeded" error)

## GATE RUN 1 (containers up, oracle.py gate())
seed_crashes_v0    = true   (exit 134; stderr: "malloc(): invalid size (unsorted)")
seed_survives_v1   = true   (exit 0;  stdout: "ok len=28893")
residual_crashes_v1= true   (exit 134; stdout: "ok len=8239752"; stderr: "double free or corruption (out)")
residual_survives_v2= true  (exit 0;  stdout: "preparse returned undef (limit exceeded)")
passed = true

## GATE RUN 2 (oracle.py --run-gate: full rebuild from scratch)
same four booleans, passed = true
seed_v0   stderr: "malloc(): invalid size (unsorted)"
residual_v1 stderr: "double free or corruption (out)"
residual_v2 stdout: "preparse returned undef (limit exceeded)"

## Teardown
PCB_FLAG=teardown docker compose --profile v0 --profile v1 --profile v2 down -v --rmi all
