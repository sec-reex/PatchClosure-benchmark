  v1 seed     apply: {"ok":false,"blocked":true,"error":"[Immer] Patching reserved attributes like __proto__, prototype and constructor is not allowed","immer_version":"8.0.1"}   check: {"polluted":null,"immer_version":"8.0.1"}
  v1 residual apply: {"ok":true,"applied":true,"immer_version":"8.0.1"}    check: {"polluted":"<FLAG>","immer_version":"8.0.1"}   <-- RESIDUAL
