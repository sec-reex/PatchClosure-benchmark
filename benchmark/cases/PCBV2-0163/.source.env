# Library CVE: published owasp-java-html-sanitizer from Maven Central.
# TYPE=maven avoids cloning java-html-sanitizer.git; runtime still uses
# com.googlecode.owasp-java-html-sanitizer:owasp-java-html-sanitizer via Dockerfile.
REPO=com.googlecode.owasp-java-html-sanitizer:owasp-java-html-sanitizer
V0=20200713.1
V1=20211018.1
TYPE=maven
GAV=com.googlecode.owasp-java-html-sanitizer:owasp-java-html-sanitizer
MAVEN_IMAGE=maven:3.9-eclipse-temurin-11
