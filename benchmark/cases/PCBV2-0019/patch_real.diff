+                template='index_constraint/sql/default/stats.sql',
+                ctx=dict(
+                    cid=22222,
+                    schema='public',
+                    name=APOSTROPHE_NAME,
+                    is_pgstattuple=True,
+                    conn=_FakeConn(),
