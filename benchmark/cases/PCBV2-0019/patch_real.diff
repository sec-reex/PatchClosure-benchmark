+            re.search(self.forbid_call_re, rendered),
+            msg=(
+                'Stats template must not call pgstat* with a '
+                "single-quoted relation name (the previously-vulnerable "
+                'pattern). Pattern: {!r}\nRendered:\n{}'
+                .format(self.forbid_call_re, rendered)
