# plexus-archiver is a Maven library. Official artifacts on Maven Central
# (CVE-2018-1002200: affected 3.5, incomplete 3.6.0; CVE-2023-37460: fixed 4.8.0).
# TYPE=maven avoids cloning codehaus-plexus/plexus-archiver git; runtime still
# uses the published jars via the Dockerfile (mvn -Dplexus.archiver.version=...).
REPO=org.codehaus.plexus:plexus-archiver
V0=3.5
V1=3.6.0
TYPE=maven
GAV=org.codehaus.plexus:plexus-archiver
