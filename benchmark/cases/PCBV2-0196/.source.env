# spring-webmvc / spring-beans are Maven libraries. Official artifacts on
# Maven Central (CVE-2010-1622: 3.0.2.RELEASE; incomplete 5.3.17;
# CVE-2022-22965 fixed 5.3.18). TYPE=maven avoids cloning spring-framework
# git; runtime still uses the published jars via the Dockerfile on official
# Tomcat images (8.5.77-jdk8 / 9.0.60-jdk17).
REPO=org.springframework:spring-webmvc
V0=3.0.2.RELEASE
V1=5.3.17
TYPE=maven
GAV=org.springframework:spring-webmvc
GAV_BEANS=org.springframework:spring-beans
TOMCAT_V0=tomcat:8.5.77-jdk8-openjdk
TOMCAT_V1=tomcat:9.0.60-jdk17-temurin
MAVEN_V0=maven:3.8-openjdk-8
MAVEN_V1=maven:3.8-eclipse-temurin-17
