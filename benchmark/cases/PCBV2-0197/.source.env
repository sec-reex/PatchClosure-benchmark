# spring-web is a Maven library. Official artifacts on Maven Central
# (CVE-2024-22259: affected <=6.1.4, fixed 6.1.5; CVE-2024-22262: affected
# <=6.1.5, fixed 6.1.6). TYPE=maven avoids cloning the full spring-framework
# git tree; runtime still uses the published jars via the Dockerfile.
REPO=org.springframework:spring-web
V0=6.1.4
V1=6.1.5
TYPE=maven
GAV=org.springframework:spring-web
