# Library CVE: published remoting jar from the Jenkins Maven repo.
# TYPE=maven avoids cloning remoting.git; runtime still uses
# org.jenkins-ci.main:remoting via Dockerfile maven-dependency-plugin.
REPO=org.jenkins-ci.main:remoting
V0=2.52
V1=2.53
TYPE=maven
GAV=org.jenkins-ci.main:remoting
MAVEN_IMAGE=maven:3.9-eclipse-temurin-8
