+	it('drops keys containing >', () => {
+		const result = String(addAttribute('val', 'x><script>alert(1)</script'));
+		assert.equal(result, '');
+	});
+
+	it('drops keys containing single quotes', () => {
+		const result = String(addAttribute('val', "x' onclick='alert(1)"));
+		assert.equal(result, '');
