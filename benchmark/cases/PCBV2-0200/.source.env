# jinjava is a Maven library. Official artifacts on Maven Central
# (CVE-2025-59340: affected 2.8.0, incomplete 2.8.1; CVE-2026-25526: fixed 2.8.3).
# TYPE=maven avoids cloning hubspot/jinjava git; runtime still uses the
# published jars via the Dockerfile (mvn -Djinjava.version=...).
REPO=com.hubspot.jinjava:jinjava
V0=2.8.0
V1=2.8.1
TYPE=maven
GAV=com.hubspot.jinjava:jinjava
