# log4j-core is a Maven library. Official artifacts on Maven Central
# (CVE-2021-44228: affected <=2.14.1, fixed 2.15.0; CVE-2021-45046: affected
# 2.15.0, fixed 2.16.0). TYPE=maven avoids cloning logging-log4j2 git;
# runtime still uses the published jars via the Dockerfile.
REPO=org.apache.logging.log4j:log4j-core
V0=2.14.1
V1=2.15.0
TYPE=maven
GAV=org.apache.logging.log4j:log4j-core
