CVE: GHSA-jqjf-f566-485j / CVE-2025-48489 first-fix (unclosed dangerous tags)
upstream: https://github.com/freescout-help-desk/freescout
fix: 1.8.179..1.8.180  Helper::stripDangerousTags

diff --git a/app/Misc/Helper.php b/app/Misc/Helper.php
index be0fdb87..1068b9bd 100644
--- a/app/Misc/Helper.php
+++ b/app/Misc/Helper.php
@@ -562,7 +562,10 @@ class Helper
         $tags = ['script', 'form', 'iframe'];
 
         foreach ($tags as $tag) {
-            $html = preg_replace('#<'.$tag.'(.*?)>(.*?)</'.$tag.'>#is', '', $html ?? '');
+            $html = preg_replace('#<'.$tag.'(.*?)>(.*?)<\s*/\s*'.$tag.'\s*>#is', '', $html ?? '');
+
+            // Remove unclosed restricted tags.
+            $html = preg_replace('#<'.$tag.'(.*?)>#is', '', $html ?? '');
         }
 
         return $html;
