<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf" xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">
    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>
    <description>PCB Canary Site Configuration</description>

    <!-- The single auth-gated flag request. auth="true" routes through OFBiz's real
         LoginWorker.checkLogin guard; https="false" keeps it on plain HTTP so the
         external probe reaches the guard directly (no https redirect). The groovy
         event writes ${PCB_FLAG} to the response only when checkLogin -> "success". -->
    <request-map uri="flag">
        <security https="false" auth="true"/>
        <event type="groovy" path="component://pcbcanary/groovyScripts/Flag.groovy"/>
        <response name="success" type="none"/>
        <response name="error" type="none"/>
    </request-map>
</site-conf>
