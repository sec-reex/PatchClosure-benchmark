# pimcore/pimcore is a Packagist package. Runtime image does
# `composer require pimcore/pimcore:${PIMCORE_VERSION}` of the WHOLE published
# package (real Pimcore app + pimcore-install). TYPE=composer is identity-only
# for fetch_source; do not git-clone pimcore/pimcore.git for the SUT.
REPO=pimcore/pimcore
V0=10.5.20
V1=10.5.21
TYPE=composer
PKG=pimcore/pimcore
