# V0 (pre-CVE-2025-58179): published @astrojs/cloudflare 12.6.5 on Astro 5.
# 12.x image-endpoint.js is selected only in a PRODUCTION build, so we
# `astro build` then serve the real Pages/Worker output via wrangler pages dev.
FROM node:22-bookworm-slim

ARG ADAPTER_VER="12.6.5"
ARG ASTRO_VER="5.18.2"

WORKDIR /app
COPY app/package.json ./package.json
COPY app/astro.config.mjs ./astro.config.mjs
COPY app/src ./src

RUN npm install --no-audit --no-fund \
      astro@${ASTRO_VER} \
      @astrojs/cloudflare@${ADAPTER_VER} \
      wrangler@^4.14.1 \
  && node -e "console.log('adapter', require('@astrojs/cloudflare/package.json').version, 'astro', require('astro/package.json').version)" \
  && npm ls --depth=0 @astrojs/cloudflare astro wrangler \
  && npx astro build

EXPOSE 4321
CMD ["npx", "wrangler", "pages", "dev", "dist", "--ip", "0.0.0.0", "--port", "4321", "--compatibility-date", "2024-09-23", "--compatibility-flag", "nodejs_compat"]
