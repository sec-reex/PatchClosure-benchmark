# craftcms/cms is a Packagist package. Runtime image does
# `composer require craftcms/cms:${CRAFT_VERSION}` of the WHOLE published
# package (real Craft app). TYPE=composer is identity-only for fetch_source;
# do not git-clone craftcms/cms.git for the SUT.
REPO=craftcms/cms
V0=5.8.20
V1=5.8.22
TYPE=composer
PKG=craftcms/cms
