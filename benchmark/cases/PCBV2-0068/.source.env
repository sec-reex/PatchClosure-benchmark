# dolphinscheduler-master / dolphinscheduler-task-api are Maven libraries.
# Official artifacts on Maven Central (CVE-2023-49299: 3.1.8 -> 3.1.9;
# CVE-2024-23320 fixed 3.2.1). TYPE=maven avoids cloning dolphinscheduler.git;
# runtime still uses the published jars via the Dockerfile (eclipse-temurin:11-jdk).
REPO=org.apache.dolphinscheduler:dolphinscheduler-master
V0=3.1.8
V1=3.1.9
TYPE=maven
GAV=org.apache.dolphinscheduler:dolphinscheduler-master
GAV_TASK_API=org.apache.dolphinscheduler:dolphinscheduler-task-api
