# thymeleaf-spring6 is a Maven library. Official artifacts on Maven Central
# (CVE-2026-40478: affected 3.1.3.RELEASE, incomplete 3.1.4.RELEASE;
# CVE-2026-41901: fixed 3.1.5.RELEASE).
# TYPE=maven avoids cloning thymeleaf/thymeleaf.git; runtime still uses the
# published jars via the Dockerfile (mvn -Dthymeleaf.version=...).
REPO=org.thymeleaf:thymeleaf-spring6
V0=3.1.3.RELEASE
V1=3.1.4.RELEASE
TYPE=maven
GAV=org.thymeleaf:thymeleaf-spring6
