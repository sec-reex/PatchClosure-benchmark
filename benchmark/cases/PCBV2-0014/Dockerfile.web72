# V0 (1.7.0) WEB runtime: php:7.2.0-cli serving a REAL upload web app. Pre-CVE-2019-12331 XmlScanner
# (single mb_convert decode, NO double-encode guard). On PHP 7.2.0 the library's own entity-loader
# availability check leaves the libxml entity loader ENABLED, so external entities resolve and the
# SCANNER regex is the sole guard (faithful pre-fix code path). Same composer:2.2 deps stage.
FROM composer:2.2 AS deps
WORKDIR /app
ARG PS_VERSION
RUN composer require phpoffice/phpspreadsheet:${PS_VERSION} \
      --no-interaction --no-progress --ignore-platform-reqs --no-scripts

FROM php:7.2.0-cli
RUN printf 'deb [check-valid-until=no] http://archive.debian.org/debian stretch main\ndeb [check-valid-until=no] http://archive.debian.org/debian-security stretch/updates main\n' > /etc/apt/sources.list
RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends --allow-unauthenticated libzip-dev zlib1g-dev libxml2-dev \
    && docker-php-ext-install zip mbstring \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=deps /app/vendor /app/vendor
COPY build_fixture.php /app/build_fixture.php
COPY www /app/www
EXPOSE 80
CMD ["php","-S","0.0.0.0:80","/app/www/router.php"]
