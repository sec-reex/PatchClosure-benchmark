+
+      expect(result.root["@_attr"]).toEqual('A'.repeat(5000));
+    });
+  });
+
+  // =================================================================
+  // EDGE CASES
+  // =================================================================
+
+  describe("Edge cases", function () {
+    it("should handle empty entity definitions", function () {
+      const xmlData = `<!DOCTYPE root [<!ENTITY empty "">]>
